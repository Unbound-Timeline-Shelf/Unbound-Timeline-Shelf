{
  "$defs": {
    "MediaAsset": {
      "additionalProperties": false,
      "description": "An asset reference; providers never write the host filesystem.",
      "properties": {
        "kind": {
          "enum": [
            "key_art",
            "banner",
            "logo",
            "icon",
            "screenshot",
            "hero",
            "poster"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "priority": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 50000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 50000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "MediaType": {
      "description": "Canonical library domains supported by provider capabilities.",
      "enum": [
        "game",
        "movie",
        "tv_show",
        "anime",
        "book"
      ],
      "title": "MediaType",
      "type": "string"
    },
    "MetadataAchievement": {
      "additionalProperties": false,
      "description": "An achievement definition from a provider's catalogue. Progress is never provider-owned.",
      "properties": {
        "external_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "progression",
                "missable",
                "win_condition"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "bronze",
                "silver",
                "gold",
                "platinum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "points": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        },
        "global_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Global Percent"
        },
        "icon_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Url"
        },
        "locked_icon_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locked Icon Url"
        },
        "source_ids": {
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]*$": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Source Ids",
          "type": "object"
        },
        "aliases": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "external_id",
        "name"
      ],
      "title": "MetadataAchievement",
      "type": "object"
    },
    "MetadataAiring": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "ongoing",
            "completed",
            "paused",
            "cancelled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "is_airing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Airing"
        },
        "aired_episodes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aired Episodes"
        },
        "total_episodes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Episodes"
        },
        "next_episode_number": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Episode Number"
        },
        "next_episode_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Episode At"
        }
      },
      "title": "MetadataAiring",
      "type": "object"
    },
    "MetadataBook": {
      "additionalProperties": false,
      "description": "What a book provider knows about a work (Plugin API 1.1.20, C15 6.3).\n\n``isbn_13``/``isbn_10`` name the edition the lookup matched (an ISBN search), if any. The\nhost keeps ``authors`` as its ordered author names; ``series_*`` stay plain fields (#265 9).",
      "properties": {
        "authors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetadataBookAuthor"
          },
          "maxItems": 30,
          "title": "Authors",
          "type": "array"
        },
        "subtitle": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "isbn_13": {
          "anyOf": [
            {
              "maxLength": 13,
              "minLength": 13,
              "pattern": "^97[89]\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isbn 13"
        },
        "isbn_10": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 10,
              "pattern": "^\\d{9}[\\dX]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isbn 10"
        },
        "page_count": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "series_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Name"
        },
        "series_position": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Position"
        },
        "original_language": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Language"
        },
        "first_published": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetadataBookDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "editions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetadataBookEdition"
          },
          "maxItems": 50,
          "title": "Editions",
          "type": "array"
        }
      },
      "title": "MetadataBook",
      "type": "object"
    },
    "MetadataBookAuthor": {
      "additionalProperties": false,
      "description": "One creator of a work, in the provider's order (C15 2.3 ``authors[]``).",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "author",
          "enum": [
            "author",
            "editor",
            "translator",
            "illustrator",
            "narrator",
            "contributor"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetadataBookAuthor",
      "type": "object"
    },
    "MetadataBookDate": {
      "additionalProperties": false,
      "description": "A book date at year, month or day precision (the C5.1 shape, in book years 1000-2100).\n\nA book can be centuries older than C5.1's 1950 floor for release years, so a work's first\npublication and an edition's date use this shape instead of ``MetadataRelease``.",
      "properties": {
        "date": {
          "maxLength": 10,
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
          "title": "Date",
          "type": "string"
        },
        "precision": {
          "enum": [
            "year",
            "month",
            "day"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "date",
        "precision"
      ],
      "title": "MetadataBookDate",
      "type": "object"
    },
    "MetadataBookEdition": {
      "additionalProperties": false,
      "description": "One edition of the work (C15 2.3 ``editions[]``, with the host's field names).\n\n``key`` is the source's own edition id. An edition never becomes a library record by\nitself: the host copies one into the work's editions only when the person adds it.",
      "properties": {
        "key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "isbn_13": {
          "anyOf": [
            {
              "maxLength": 13,
              "minLength": 13,
              "pattern": "^97[89]\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isbn 13"
        },
        "isbn_10": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 10,
              "pattern": "^\\d{9}[\\dX]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isbn 10"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "paperback",
                "hardcover",
                "ebook",
                "audiobook",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "publish_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetadataBookDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_count": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        }
      },
      "title": "MetadataBookEdition",
      "type": "object"
    },
    "MetadataCandidate": {
      "additionalProperties": false,
      "description": "Lightweight identity; metadata and artwork are separate operations.",
      "properties": {
        "external_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 3000,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType",
          "default": "game"
        },
        "alternate_titles": {
          "default": [],
          "items": {
            "maxLength": 512,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Alternate Titles",
          "type": "array"
        },
        "provider_ids": {
          "maxProperties": 32,
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]*$": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Provider Ids",
          "type": "object"
        },
        "platforms": {
          "default": [],
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Platforms",
          "type": "array"
        },
        "authors": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Authors",
          "type": "array"
        },
        "isbn_13": {
          "anyOf": [
            {
              "maxLength": 13,
              "minLength": 13,
              "pattern": "^97[89]\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isbn 13"
        }
      },
      "required": [
        "external_id",
        "title",
        "provider"
      ],
      "title": "MetadataCandidate",
      "type": "object"
    },
    "MetadataEpisode": {
      "additionalProperties": false,
      "description": "Provider-neutral episode data; watched state remains entirely host-owned.",
      "properties": {
        "episode_number": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Episode Number",
          "type": "integer"
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Number"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "air_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Air Date"
        },
        "air_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Air At"
        },
        "runtime_minutes": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Minutes"
        },
        "still_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Still Url"
        }
      },
      "required": [
        "episode_number"
      ],
      "title": "MetadataEpisode",
      "type": "object"
    },
    "MetadataIdentity": {
      "additionalProperties": false,
      "description": "How the provider matched the lookup to its record (Plugin API 1.1.20, C4.4).\n\n``id``, ``redirect`` and ``crosswalk`` are identity evidence; ``previous_ids`` names ids the\nprovider no longer uses for this record (a merge or redirect), so the host can follow them.\n``conflict`` and ``ambiguous`` are never assigned automatically.",
      "properties": {
        "match": {
          "enum": [
            "id",
            "redirect",
            "crosswalk",
            "exact",
            "conflict",
            "ambiguous"
          ],
          "title": "Match",
          "type": "string"
        },
        "previous_ids": {
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]*$": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Previous Ids",
          "type": "object"
        }
      },
      "required": [
        "match"
      ],
      "title": "MetadataIdentity",
      "type": "object"
    },
    "MetadataLink": {
      "additionalProperties": false,
      "description": "A provider reference rendered by the existing application links UI.",
      "properties": {
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "MetadataLink",
      "type": "object"
    },
    "MetadataPatch": {
      "additionalProperties": false,
      "description": "Partial canonical fields; missing values never erase existing information.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 3000,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "release_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Date"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "developer": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Developer"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "series": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "age_rating": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Rating"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Tags",
          "type": "array"
        },
        "features": {
          "default": [],
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Features",
          "type": "array"
        },
        "genres": {
          "default": [],
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Genres",
          "type": "array"
        },
        "platforms": {
          "default": [],
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Platforms",
          "type": "array"
        },
        "time_to_beat_hours": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "number"
